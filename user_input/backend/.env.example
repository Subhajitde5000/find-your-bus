# MongoDB is the persistent store. Keep this URI private.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=pathsathi_user_input

# Replace with a long random value before deploying the admin dashboard.
ADMIN_SESSION_SECRET=replace-this-with-a-long-random-secret
ADMIN_COOKIE_SECURE=false

# Admin credentials — never hardcode these in source code.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-secure-password
ADMIN_COOKIE_NAME=pathsathi_admin_session

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:3000
